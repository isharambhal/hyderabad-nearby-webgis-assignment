{
  "apiVersion": "v1",
  "kind": "ConfigMap",
  "metadata": {
    "name": "webgis-client-html",
    "namespace": "webgis-k8s"
  },
  "data": {
    "index.html": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n  <meta charset=\"UTF-8\">\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n  <title>Hyderabad | Healthcare Accessibility WebGIS</title>\r\n  <link href=\"https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css\" rel=\"stylesheet\">\r\n  <script src=\"https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js\"></script>\r\n  <style>\r\n    :root {\r\n      --navy: #102b46;\r\n      --navy-2: #173d5c;\r\n      --teal: #13a89e;\r\n      --ink: #1c2d3d;\r\n      --muted: #65778a;\r\n      --line: #e1e8ef;\r\n      --panel: #ffffff;\r\n      --canvas: #f2f6fa;\r\n      --green: #21966f;\r\n      --amber: #e6a23c;\r\n      --red: #df554e;\r\n      --shadow: 0 8px 28px rgba(20, 43, 66, .10);\r\n    }\r\n    * { box-sizing: border-box; }\r\n    html, body { height: 100%; margin: 0; }\r\n    body {\r\n      font-family: Inter, \"Segoe UI\", Arial, sans-serif;\r\n      color: var(--ink);\r\n      background: var(--canvas);\r\n      overflow: hidden;\r\n    }\r\n    .topbar {\r\n      height: 66px;\r\n      padding: 0 22px;\r\n      display: flex;\r\n      align-items: center;\r\n      justify-content: space-between;\r\n      gap: 16px;\r\n      color: #fff;\r\n      background: linear-gradient(115deg, var(--navy), var(--navy-2));\r\n      box-shadow: 0 3px 14px rgba(10, 31, 51, .2);\r\n      position: relative;\r\n      z-index: 5;\r\n    }\r\n    .brand { display: flex; align-items: center; gap: 12px; min-width: 0; }\r\n    .brand-mark {\r\n      width: 38px; height: 38px; border-radius: 12px;\r\n      display: grid; place-items: center;\r\n      color: white; font-size: 19px; font-weight: 800;\r\n      background: linear-gradient(145deg, #21b7a9, #087d91);\r\n      box-shadow: inset 0 1px 0 rgba(255,255,255,.3);\r\n      flex: 0 0 auto;\r\n    }\r\n    .brand h1 { margin: 0; font-size: 17px; letter-spacing: .1px; font-weight: 700; }\r\n    .brand p { margin: 3px 0 0; color: #c5d7e5; font-size: 11px; }\r\n    .top-meta { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }\r\n    .top-pill {\r\n      border: 1px solid rgba(255,255,255,.2);\r\n      background: rgba(255,255,255,.09);\r\n      color: #e9f5fb;\r\n      border-radius: 999px;\r\n      padding: 7px 10px;\r\n      font-size: 11px;\r\n      white-space: nowrap;\r\n    }\r\n    .workspace {\r\n      height: calc(100% - 66px);\r\n      display: grid;\r\n      grid-template-columns: 300px minmax(0, 1fr);\r\n      gap: 0;\r\n    }\r\n    .sidebar {\r\n      padding: 17px 15px 20px;\r\n      overflow-y: auto;\r\n      background: #f7f9fc;\r\n      border-right: 1px solid #dce5ed;\r\n      z-index: 2;\r\n    }\r\n    .intro { padding: 2px 3px 14px; }\r\n    .eyebrow {\r\n      color: #168f8c; font-size: 10px; font-weight: 800;\r\n      letter-spacing: 1.2px; text-transform: uppercase;\r\n    }\r\n    .intro h2 { margin: 6px 0 5px; font-size: 19px; color: var(--navy); }\r\n    .intro p { margin: 0; color: var(--muted); font-size: 12px; line-height: 1.5; }\r\n    .panel {\r\n      background: var(--panel);\r\n      border: 1px solid var(--line);\r\n      border-radius: 13px;\r\n      padding: 14px;\r\n      margin: 0 0 12px;\r\n      box-shadow: 0 3px 12px rgba(23, 54, 82, .035);\r\n    }\r\n    .panel-heading {\r\n      display: flex; align-items: center; justify-content: space-between;\r\n      gap: 8px; margin-bottom: 11px;\r\n    }\r\n    .panel h3 { margin: 0; font-size: 12px; color: var(--navy); letter-spacing: .25px; }\r\n    .step-tag {\r\n      color: #168f8c; background: #e8f7f5; border-radius: 999px;\r\n      padding: 4px 7px; font-size: 9px; font-weight: 700;\r\n    }\r\n    .layer-row {\r\n      display: flex; align-items: center; gap: 9px;\r\n      padding: 8px 0; margin: 0; font-size: 12px; color: #34495d;\r\n      border-top: 1px solid #f0f3f6; cursor: pointer;\r\n    }\r\n    .layer-row:first-of-type { border-top: 0; }\r\n    input[type=\"checkbox\"] { accent-color: #0d9992; width: 15px; height: 15px; margin: 0; }\r\n    .layer-symbol { width: 10px; height: 10px; border-radius: 3px; flex: 0 0 auto; }\r\n    .layer-symbol.dot { border-radius: 50%; }\r\n    select, button {\r\n      width: 100%; border-radius: 8px; font: inherit;\r\n    }\r\n    select {\r\n      padding: 10px 11px; border: 1px solid #d7e1e9;\r\n      background: #fbfdff; color: #263b4e; font-size: 12px;\r\n      outline: none;\r\n    }\r\n    select:focus { border-color: #19a69d; box-shadow: 0 0 0 3px rgba(25,166,157,.12); }\r\n    .field-label {\r\n      display: block; font-size: 10px; color: var(--muted);\r\n      margin: 10px 0 6px; font-weight: 700; text-transform: uppercase; letter-spacing: .55px;\r\n    }\r\n    .legend-item {\r\n      display: flex; align-items: center; gap: 9px;\r\n      color: #4d6072; font-size: 11px; margin: 9px 0;\r\n    }\r\n    .legend-swatch {\r\n      width: 15px; height: 15px; border: 1px solid rgba(34,52,69,.18);\r\n      border-radius: 4px; flex: 0 0 auto;\r\n    }\r\n    .legend-swatch.circle { border-radius: 50%; }\r\n    .status-line { display: flex; align-items: flex-start; gap: 8px; }\r\n    .status-dot {\r\n      width: 8px; height: 8px; background: #19a77b; border-radius: 50%;\r\n      margin-top: 4px; flex: 0 0 auto; box-shadow: 0 0 0 3px #e7f7f1;\r\n    }\r\n    #status { margin: 0; color: #53677a; font-size: 11px; line-height: 1.5; overflow-wrap: anywhere; }\r\n    .zoom-btn {\r\n      margin-top: 12px; padding: 10px 12px; border: 0;\r\n      background: linear-gradient(110deg, #087f8c, #12a69a);\r\n      color: white; font-size: 12px; font-weight: 700;\r\n      cursor: pointer; box-shadow: 0 5px 12px rgba(10,145,140,.18);\r\n      transition: transform .15s, box-shadow .15s;\r\n    }\r\n    .zoom-btn:hover { transform: translateY(-1px); box-shadow: 0 7px 15px rgba(10,145,140,.24); }\r\n    .map-wrap { position: relative; min-width: 0; min-height: 0; background: #dce7ec; }\r\n    #map { position: absolute; inset: 0; }\r\n    .map-caption {\r\n      position: absolute; z-index: 1; top: 14px; left: 14px;\r\n      padding: 9px 12px; border: 1px solid rgba(255,255,255,.75);\r\n      border-radius: 10px; background: rgba(255,255,255,.93);\r\n      box-shadow: var(--shadow); pointer-events: none;\r\n    }\r\n    .map-caption strong { display: block; color: var(--navy); font-size: 11px; }\r\n    .map-caption span { display: block; margin-top: 3px; color: #718294; font-size: 10px; }\r\n    .maplibregl-popup-content {\r\n      border-radius: 10px; padding: 12px 14px;\r\n      box-shadow: 0 8px 24px rgba(16,43,70,.18);\r\n      font: 12px/1.5 \"Segoe UI\", Arial, sans-serif;\r\n    }\r\n    .maplibregl-popup-close-button { padding: 4px 8px; font-size: 16px; }\r\n    @media(max-width: 760px) {\r\n      body { overflow: auto; }\r\n      .topbar { height: auto; min-height: 62px; padding: 10px 13px; }\r\n      .brand h1 { font-size: 14px; }\r\n      .top-meta { display: none; }\r\n      .workspace { height: auto; min-height: calc(100% - 62px); grid-template-columns: 1fr; }\r\n      .sidebar { order: 2; border-right: 0; border-top: 1px solid var(--line); }\r\n      .map-wrap { order: 1; height: 58vh; min-height: 360px; }\r\n    }\r\n  </style>\r\n</head>\r\n<body>\r\n  <header class=\"topbar\">\r\n    <div class=\"brand\">\r\n      <div class=\"brand-mark\">H</div>\r\n      <div>\r\n        <h1>Hyderabad Healthcare Accessibility</h1>\r\n        <p>Geospatial decision-support map \u00c2\u00b7 Serilingampally & Hafeezpet</p>\r\n      </div>\r\n    </div>\r\n    <div class=\"top-meta\">\r\n      <span class=\"top-pill\">POSTGIS</span>\r\n      <span class=\"top-pill\">GEOSERVER</span>\r\n      <span class=\"top-pill\">OGC API</span>\r\n      <span class=\"top-pill\">MAPLIBRE</span>\r\n    </div>\r\n  </header>\r\n\r\n  <main class=\"workspace\">\r\n    <aside class=\"sidebar\">\r\n      <div class=\"intro\">\r\n        <div class=\"eyebrow\">Interactive WebGIS</div>\r\n        <h2>Map controls</h2>\r\n        <p>Explore healthcare locations and compare walking-access coverage across H3 cells.</p>\r\n      </div>\r\n\r\n      <section class=\"panel\">\r\n        <div class=\"panel-heading\"><h3>MAP LAYERS</h3><span class=\"step-tag\">01 \u00c2\u00b7 DISPLAY</span></div>\r\n        <label class=\"layer-row\"><input type=\"checkbox\" id=\"h3Toggle\" checked><span class=\"layer-symbol\" style=\"background:#21966f\"></span>H3 accessibility grid</label>\r\n        <label class=\"layer-row\"><input type=\"checkbox\" id=\"serviceToggle\" checked><span class=\"layer-symbol dot\" style=\"background:#df554e\"></span>Healthcare services</label>\r\n        <label class=\"layer-row\"><input type=\"checkbox\" id=\"boundaryToggle\" checked><span class=\"layer-symbol\" style=\"background:#4d8cae\"></span>Study area boundary (WMS)</label>\r\n        <label class=\"layer-row\"><input type=\"checkbox\" id=\"buildingToggle\"><span class=\"layer-symbol\" style=\"background:#8493a1\"></span>Buildings (WFS GeoJSON)</label>\r\n        <p style=\"font-size:10px;color:#8392a0;line-height:1.4;margin:7px 0 0 24px\">Building features are fetched only when this layer is switched on.</p>\r\n      </section>\r\n\r\n      <section class=\"panel\">\r\n        <div class=\"panel-heading\"><h3>ACCESSIBILITY ANALYSIS</h3><span class=\"step-tag\">02 \u00c2\u00b7 COMPARE</span></div>\r\n        <label class=\"field-label\" for=\"resolution\">H3 grid resolution</label>\r\n        <select id=\"resolution\">\r\n          <option value=\"9\" selected>Resolution 9 \u00c2\u00b7 finer cells</option>\r\n          <option value=\"8\">Resolution 8 \u00c2\u00b7 larger cells</option>\r\n        </select>\r\n        <label class=\"field-label\" for=\"scenario\">Coverage scenario</label>\r\n        <select id=\"scenario\">\r\n          <option value=\"network_covered_4_8\">Walking network \u00c2\u00b7 4.8 km/h</option>\r\n          <option value=\"network_covered_3_6\">Walking network \u00c2\u00b7 3.6 km/h</option>\r\n          <option value=\"buffer_covered_4_8\">Straight-line buffer \u00c2\u00b7 4.8 km/h</option>\r\n        </select>\r\n      </section>\r\n\r\n      <section class=\"panel\">\r\n        <div class=\"panel-heading\"><h3>MAP LEGEND</h3><span class=\"step-tag\">03 \u00c2\u00b7 INTERPRET</span></div>\r\n        <div class=\"legend-item\"><span class=\"legend-swatch\" style=\"background:#21966f\"></span>Covered H3 cell</div>\r\n        <div class=\"legend-item\"><span class=\"legend-swatch\" style=\"background:#e6a23c\"></span>Not covered H3 cell</div>\r\n        <div class=\"legend-item\"><span class=\"legend-swatch circle\" style=\"background:#df554e\"></span>Healthcare service location</div>\r\n        <div class=\"legend-item\"><span class=\"legend-swatch\" style=\"background:#8493a1\"></span>Building footprint</div>\r\n        <div class=\"legend-item\"><span class=\"legend-swatch\" style=\"background:#4d8cae\"></span>Study area WMS overlay</div>\r\n      </section>\r\n\r\n      <section class=\"panel\">\r\n        <div class=\"panel-heading\"><h3>MAP STATUS</h3><span class=\"step-tag\">LIVE</span></div>\r\n        <div class=\"status-line\">\r\n          <span class=\"status-dot\"></span>\r\n          <p id=\"status\">Connecting to map services\u00e2\u20ac\u00a6</p>\r\n        </div>\r\n        <button class=\"zoom-btn\" id=\"zoomButton\" type=\"button\">\u00e2\u0152\u2013 &nbsp; Zoom to study area</button>\r\n      </section>\r\n    </aside>\r\n\r\n    <section class=\"map-wrap\">\r\n      <div id=\"map\"></div>\r\n      <div class=\"map-caption\">\r\n        <strong>Study area \u00c2\u00b7 Hyderabad, Telangana</strong>\r\n        <span>Ward 106 Serilingampally \u00c2\u00b7 Ward 109 Hafeezpet</span>\r\n      </div>\r\n    </section>\r\n  </main>\r\n\r\n<script>\r\n  const CENTER = [78.3377, 17.4671];\r\n  const h3Tiles = 'http://localhost:7800/public.phase3_h3_access/{z}/{x}/{y}.pbf';\r\n  const serviceUrl = 'http://localhost:9000/collections/public.phase2_services/items?limit=10000';\r\n  const buildingUrl = 'http://localhost:8085/geoserver/hyderabad/ows?' +\r\n    'service=WFS&version=2.0.0&request=GetFeature&' +\r\n    'typeNames=hyderabad:phase2_buildings&outputFormat=application/json';\r\n  const wmsUrl = 'http://localhost:8085/geoserver/hyderabad/wms?' +\r\n    'service=WMS&version=1.1.1&request=GetMap&' +\r\n    'layers=hyderabad:phase2_study_area&styles=&' +\r\n    'format=image/png&transparent=true&srs=EPSG:3857&' +\r\n    'width=256&height=256&bbox={bbox-epsg-3857}';\r\n\r\n  const statusElement = document.getElementById('status');\r\n  const setStatus = (message) => { statusElement.textContent = message; };\r\n\r\n  const map = new maplibregl.Map({\r\n    container: 'map',\r\n    center: CENTER,\r\n    zoom: 13,\r\n    style: {\r\n      version: 8,\r\n      sources: {\r\n        osm: {\r\n          type: 'raster',\r\n          tiles: ['https://tile.openstreetmap.org/{z}/{x}/{y}.png'],\r\n          tileSize: 256,\r\n          attribution: '\u00c2\u00a9 OpenStreetMap contributors'\r\n        }\r\n      },\r\n      layers: [{ id: 'osm-basemap', type: 'raster', source: 'osm' }]\r\n    }\r\n  });\r\n\r\n  map.addControl(new maplibregl.NavigationControl(), 'top-right');\r\n  map.addControl(new maplibregl.ScaleControl(), 'bottom-right');\r\n\r\n  let buildingsLoaded = false;\r\n  let serviceCount = 0;\r\n\r\n  function updateH3Style() {\r\n    if (!map.getLayer('h3-fill')) return;\r\n    const field = document.getElementById('scenario').value;\r\n    const resolution = Number(document.getElementById('resolution').value);\r\n    map.setFilter('h3-fill', ['==', ['get', 'resolution'], resolution]);\r\n    map.setPaintProperty('h3-fill', 'fill-color', [\r\n      'case', ['==', ['get', field], true], '#21966f', '#e6a23c'\r\n    ]);\r\n  }\r\n\r\n  function safeText(value, fallback) {\r\n    return value === null || value === undefined || value === '' ? fallback : String(value);\r\n  }\r\n\r\n  map.on('load', async () => {\r\n    // Add WMS first so that the H3 grid is drawn above it rather than hidden underneath.\r\n    map.addSource('study-wms', { type: 'raster', tiles: [wmsUrl], tileSize: 256 });\r\n    map.addLayer({\r\n      id: 'study-boundary',\r\n      type: 'raster',\r\n      source: 'study-wms',\r\n      paint: { 'raster-opacity': 0.25 }\r\n    });\r\n\r\n    map.addSource('h3', {\r\n      type: 'vector',\r\n      tiles: [h3Tiles],\r\n      minzoom: 0,\r\n      maxzoom: 22\r\n    });\r\n    map.addLayer({\r\n      id: 'h3-fill',\r\n      type: 'fill',\r\n      source: 'h3',\r\n      'source-layer': 'public.phase3_h3_access',\r\n      paint: {\r\n        'fill-color': [\r\n          'case', ['==', ['get', 'network_covered_4_8'], true], '#21966f', '#e6a23c'\r\n        ],\r\n        'fill-opacity': 0.58,\r\n        'fill-outline-color': '#ffffff'\r\n      }\r\n    });\r\n    updateH3Style();\r\n\r\n    try {\r\n      const response = await fetch(serviceUrl);\r\n      if (!response.ok) throw new Error('Healthcare API HTTP ' + response.status);\r\n      const serviceData = await response.json();\r\n      serviceCount = Array.isArray(serviceData.features) ? serviceData.features.length : 0;\r\n\r\n      map.addSource('services', { type: 'geojson', data: serviceData });\r\n      map.addLayer({\r\n        id: 'services-points',\r\n        type: 'circle',\r\n        source: 'services',\r\n        paint: {\r\n          'circle-radius': ['interpolate', ['linear'], ['zoom'], 10, 3.5, 15, 7],\r\n          'circle-color': '#df554e',\r\n          'circle-stroke-color': '#ffffff',\r\n          'circle-stroke-width': 1.7\r\n        }\r\n      });\r\n\r\n      map.on('click', 'services-points', (event) => {\r\n        const p = event.features[0].properties || {};\r\n        const content = document.createElement('div');\r\n        const title = document.createElement('strong');\r\n        title.textContent = safeText(p.name, 'Healthcare service');\r\n        const category = document.createElement('div');\r\n        category.textContent = 'Category: ' + safeText(p.category, 'Not available');\r\n        content.append(title, category);\r\n        new maplibregl.Popup({ offset: 10 })\r\n          .setLngLat(event.lngLat)\r\n          .setDOMContent(content)\r\n          .addTo(map);\r\n      });\r\n      map.on('mouseenter', 'services-points', () => { map.getCanvas().style.cursor = 'pointer'; });\r\n      map.on('mouseleave', 'services-points', () => { map.getCanvas().style.cursor = ''; });\r\n    } catch (error) {\r\n      console.error('Healthcare API error:', error);\r\n      setStatus('Healthcare API error: ' + error.message);\r\n    }\r\n\r\n    async function loadBuildings() {\r\n      if (buildingsLoaded) return;\r\n      const response = await fetch(buildingUrl);\r\n      if (!response.ok) throw new Error('Building WFS HTTP ' + response.status);\r\n      const data = await response.json();\r\n      if (!data || !Array.isArray(data.features)) {\r\n        throw new Error('WFS response did not contain a GeoJSON features array.');\r\n      }\r\n      map.addSource('buildings', { type: 'geojson', data });\r\n      map.addLayer({\r\n        id: 'building-polygons',\r\n        type: 'fill',\r\n        source: 'buildings',\r\n        paint: {\r\n          'fill-color': '#8493a1',\r\n          'fill-opacity': 0.25,\r\n          'fill-outline-color': '#536575'\r\n        }\r\n      }, map.getLayer('h3-fill') ? 'h3-fill' : undefined);\r\n      buildingsLoaded = true;\r\n    }\r\n\r\n    document.getElementById('h3Toggle').addEventListener('change', (e) => {\r\n      map.setLayoutProperty('h3-fill', 'visibility', e.target.checked ? 'visible' : 'none');\r\n    });\r\n    document.getElementById('serviceToggle').addEventListener('change', (e) => {\r\n      if (map.getLayer('services-points')) {\r\n        map.setLayoutProperty('services-points', 'visibility', e.target.checked ? 'visible' : 'none');\r\n      }\r\n    });\r\n    document.getElementById('boundaryToggle').addEventListener('change', (e) => {\r\n      map.setLayoutProperty('study-boundary', 'visibility', e.target.checked ? 'visible' : 'none');\r\n    });\r\n    document.getElementById('buildingToggle').addEventListener('change', async (e) => {\r\n      const checkbox = e.target;\r\n      try {\r\n        if (checkbox.checked) {\r\n          checkbox.disabled = true;\r\n          setStatus('Loading building footprints from GeoServer WFS\u00e2\u20ac\u00a6');\r\n          await loadBuildings();\r\n          map.setLayoutProperty('building-polygons', 'visibility', 'visible');\r\n          setStatus('Healthcare features: ' + serviceCount + '. Buildings loaded.');\r\n        } else if (map.getLayer('building-polygons')) {\r\n          map.setLayoutProperty('building-polygons', 'visibility', 'none');\r\n          setStatus('Healthcare features: ' + serviceCount + '. Buildings hidden.');\r\n        }\r\n      } catch (error) {\r\n        checkbox.checked = false;\r\n        console.error('Building WFS error:', error);\r\n        alert('Could not load buildings: ' + error.message);\r\n        setStatus('Building layer error: ' + error.message);\r\n      } finally {\r\n        checkbox.disabled = false;\r\n      }\r\n    });\r\n\r\n    document.getElementById('scenario').addEventListener('change', updateH3Style);\r\n    document.getElementById('resolution').addEventListener('change', updateH3Style);\r\n    document.getElementById('zoomButton').addEventListener('click', () => {\r\n      map.flyTo({ center: CENTER, zoom: 13, essential: true });\r\n    });\r\n\r\n    setStatus('Connected \u00c2\u00b7 ' + serviceCount + ' healthcare features. H3 tiles and study-area WMS enabled.');\r\n  });\r\n\r\n  map.on('error', (event) => {\r\n    console.warn('Map service/rendering message:', event.error || event);\r\n  });\r\n</script>\r\n</body>\r\n</html>"
  }
}